---
interface Props {
  stats: string;
  quickPicks: { id: string; name: string }[];
}
const { stats, quickPicks } = Astro.props;
---

<header class="top">
  <div class="brand"><h1>NMS Recipe Finder</h1><span id="stats">{stats}</span></div>
  <div class="search">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
      <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
    </svg>
    <input
      id="q"
      type="search"
      autocomplete="off"
      spellcheck="false"
      placeholder="I need… (e.g. Radon, Chromatic Metal, Warp Cell)"
      aria-label="Search items"
      role="combobox"
      aria-expanded="false"
      aria-controls="results"
      aria-autocomplete="list"
    />
    <div id="results" class="results" role="listbox" hidden></div>
  </div>
  <div class="quick">
    <span class="lbl">Try:</span>
    {quickPicks.map((p) => <button class="pill" data-go={p.id}>{p.name}</button>)}
  </div>
  <div class="quick">
    <button class="pill ref" data-go="cycles">⟳ Conversion cycles</button>
    <button class="pill ref" data-go="consumables">⚗ Refining consumables</button>
    <button class="pill ref" data-go="cooking">🍳 Cooking reference</button>
  </div>
</header>
